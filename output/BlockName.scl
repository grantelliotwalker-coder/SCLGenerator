FUNCTION_BLOCK "BlockName"
TITLE = 'Block Title Here'
{
S7_m_c:='true';
S7_tasklist:='OB100'
}
AUTHOR : 'WALKER'
FAMILY : 'GCCC'
NAME : 'ShortNam'
VERSION : '1.0'
KNOW_HOW_PROTECT

// Purpose : Reusable template block with working compilable logic.
//
// How it works:
// BoolInput1 enables the block. When enabled, RealInput1 (clamped 0-100) is compared to RealSetpoint1.
// If RealInput1 stays above RealSetpoint1 for IntInput1 consecutive scans, the on delay timer starts
// and BoolOutput1 turns on when it elapses. When the condition is lost the off delay turns it off.
// When BoolInput1 is FALSE the block resets cleanly.
// StatusString always reflects the current operating condition for diagnostics.
//
// Generated by sclgen 1.0 from a JSON block spec. Edit the spec and regenerate
// rather than editing this file by hand.

VAR_INPUT
    BoolInput1 {S7_m_c:='true'} : BOOL := FALSE; // Block enable, must be TRUE for any logic to run
    RealInput1 {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 0.0; // Measured process value to compare against setpoint (engineering units)
    RealSetpoint1 {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 50.0; // Setpoint RealInput1 must exceed (engineering units, 0-100)
    IntInput1 {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : INT := 10; // Number of consecutive scans RealInput1 must exceed RealSetpoint1 before timing starts
    OnDelayTime {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 5.0; // On delay in seconds before BoolOutput1 turns on
    OffDelayTime {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 3.0; // Off delay in seconds before BoolOutput1 turns off
    SampleTime {S7_visible:='false'; S7_sampletime:='true'; S7_param:='false'; S7_link:='false'} : REAL; // Cycle time of the PLC in seconds, used for timer logic
END_VAR

VAR_OUTPUT
    BoolOutput1 {S7_m_c:='true'} : BOOL := FALSE; // Output active flag, TRUE when condition confirmed for timer duration
    RealOutput1 {S7_m_c:='true'} : REAL := 0.0; // Scaled output value, reflects RealInput1 when active, zero when inactive
    IntOutput1 {S7_m_c:='true'} : INT := 0; // State, 0 = idle, 1 = on delay timing, 2 = active with off delay timing, 3 = active
    StatusString {S7_m_c:='true'} : STRING[50]; // Diagnostic status string indicating current operating condition
END_VAR

VAR
    // Internal working variables
    InternalReal1 : REAL := 0.0; // RealInput1 clamped to 0-100 for internal calculations
    InternalInt1 : INT := 0; // Scan counter, consecutive scans RealInput1 has exceeded the setpoint

    tmTimers : ARRAY[0..1] OF STRUCT // Timer array, index 0 = on_delay, index 1 = off_delay
        IN : BOOL; // Timer input, TRUE starts the timer accumulating
        Q : BOOL; // Timer output, TRUE when ET reaches PT, stays TRUE while IN is held
        RESET : BOOL := FALSE; // Set TRUE to clear ET/RT and hold Q FALSE for one scan, engine clears it
        PT : REAL; // Preset time in seconds, written every scan in the timer presets section
        ET : REAL; // Elapsed time in seconds, incremented each scan by SampleTime
        RT : REAL; // Remaining time in seconds, PT minus ET, clamped to zero
    END_STRUCT;
    tiIndex : INT; // Loop index for the timer execution FOR loop
END_VAR

BEGIN

// -----------------------------------------------------------------------------------------
// SECTION 1: BLOCK ENABLE AND RESET
// If BoolInput1 is FALSE, everything is reset to a clean idle state and the block exits.
// This ensures the block always starts fresh when re-enabled after being disabled.
// -----------------------------------------------------------------------------------------
IF NOT BoolInput1 THEN
    BoolOutput1 := FALSE; // Back to initial value
    RealOutput1 := 0.0; // Back to initial value
    InternalReal1 := 0.0; // Back to initial value
    InternalInt1 := 0; // Back to initial value
    IntOutput1 := 0; // Return to safe state
    StatusString := 'Disabled';
    FOR tiIndex := 0 TO 1 DO // Stop and clear every timer
        tmTimers[tiIndex].IN := FALSE;
        tmTimers[tiIndex].Q := FALSE;
        tmTimers[tiIndex].RESET := FALSE;
        tmTimers[tiIndex].ET := 0.0;
        tmTimers[tiIndex].RT := 0.0;
    END_FOR;
    RETURN; // Exit the block early, skip all logic below
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 2: TIMER PRESETS
// Presets are written every scan so changes from the HMI or engineering take effect immediately.
// Presets taken from inputs are clamped to 0..86400 s so a bad entry cannot break the timer.
// -----------------------------------------------------------------------------------------
tmTimers[0].PT := LIMIT(MN:=0.0, IN:=OnDelayTime, MX:=86400.0); // on_delay: On delay before output turns on
tmTimers[1].PT := LIMIT(MN:=0.0, IN:=OffDelayTime, MX:=86400.0); // off_delay: Off delay before output turns off

// -----------------------------------------------------------------------------------------
// SECTION 3: INPUT CONDITIONING
// InternalReal1 clamps RealInput1 to a 0-100 range for safe use downstream.
// InternalInt1 counts consecutive scans where it exceeds RealSetpoint1.
// -----------------------------------------------------------------------------------------
InternalReal1 := LIMIT(MN:=0.0, IN:=RealInput1, MX:=100.0); // Clamp RealInput1 to 0-100 range

IF InternalReal1 > RealSetpoint1 THEN
    IF InternalInt1 < 32767 THEN
        InternalInt1 := InternalInt1 + 1; // Count consecutive scans above setpoint, capped so it cannot overflow
    END_IF;
ELSE
    InternalInt1 := 0; // Reset the moment RealInput1 drops back to or below setpoint
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 4: TIMER CONTROL LOGIC
// The on delay starts once the scan counter confirms the condition for IntInput1 scans.
// This double confirmation prevents false triggers from signal spikes.
// The off delay starts when the output is active but the condition is lost.
// -----------------------------------------------------------------------------------------
IF InternalInt1 >= IntInput1 AND NOT BoolOutput1 THEN
    tmTimers[0].IN := TRUE; // Condition confirmed for enough scans, start on delay
    tmTimers[1].IN := FALSE;
ELSIF BoolOutput1 AND InternalInt1 = 0 THEN
    tmTimers[1].IN := TRUE; // Output on but condition lost, start off delay
    tmTimers[0].IN := FALSE;
ELSE
    tmTimers[0].IN := FALSE; // No transition pending, stop both timers
    tmTimers[1].IN := FALSE;
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 5: OUTPUT LOGIC
// On delay elapsing turns the output on, off delay elapsing turns it off.
// RealOutput1 tracks the clamped process value while active and clears when inactive.
// -----------------------------------------------------------------------------------------
IF tmTimers[0].Q THEN
    BoolOutput1 := TRUE; // On delay elapsed, condition confirmed
    tmTimers[0].IN := FALSE;
    tmTimers[0].RESET := TRUE; // Ready for next cycle
END_IF;

IF tmTimers[1].Q THEN
    BoolOutput1 := FALSE; // Off delay elapsed, condition lost
    tmTimers[1].IN := FALSE;
    tmTimers[1].RESET := TRUE; // Ready for next cycle
END_IF;

IF BoolOutput1 THEN
    RealOutput1 := InternalReal1; // Pass scaled value while active
ELSE
    RealOutput1 := 0.0; // Clear when inactive
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 6: STATE AND STATUS
// IntOutput1 gives a simple integer state that can be trended or alarmed on the HMI.
// StatusString gives a plain English description for diagnostics on the operator screen.
// States are tested in priority order; the first matching condition wins.
// -----------------------------------------------------------------------------------------
IF tmTimers[0].IN THEN
    IntOutput1 := 1; // On delay timing
ELSIF BoolOutput1 AND tmTimers[1].IN THEN
    IntOutput1 := 2; // Active, off delay timing
ELSIF BoolOutput1 THEN
    IntOutput1 := 3; // Active
ELSE
    IntOutput1 := 0; // Idle
END_IF;

CASE IntOutput1 OF
    0: // Idle
        StatusString := 'Idle: Waiting for condition';
    1: // On delay timing
        StatusString := 'Timing: On delay active';
    2: // Active, off delay timing
        StatusString := 'Active: Off delay counting';
    3: // Active
        StatusString := 'Active: Output on';
    ELSE // Unexpected state, fail safe
        StatusString := 'Error/Unknown';
        IntOutput1 := 0; // Force back to safe state so block recovers automatically
END_CASE;

//********************************************************************************************
// Timers execution
// Runs every timer in the array with a single FOR loop; each element works identically.
// SampleTime is added to ET each scan the timer IN is active. When ET reaches PT, RT reaches
// zero and Q goes TRUE. Q stays TRUE while IN is held. RESET clears the timer for one scan
// and is then cleared by the engine itself, so the timer is ready for its next cycle.
//********************************************************************************************
FOR tiIndex := 0 TO 1 DO
    IF tmTimers[tiIndex].RESET THEN
        tmTimers[tiIndex].ET := 0.0; // Clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Hold output off while resetting
        tmTimers[tiIndex].RESET := FALSE; // Reset handled, clear the flag so the timer can run again
    ELSIF tmTimers[tiIndex].IN THEN
        IF NOT tmTimers[tiIndex].Q THEN
            tmTimers[tiIndex].ET := tmTimers[tiIndex].ET + SampleTime; // Accumulate elapsed time
        END_IF;
        tmTimers[tiIndex].RT := LIMIT(MN:=0.0, IN:=tmTimers[tiIndex].PT - tmTimers[tiIndex].ET, MX:=tmTimers[tiIndex].PT); // Remaining time, never below 0
        tmTimers[tiIndex].Q := tmTimers[tiIndex].RT <= 0.0; // Done when no time remains
    ELSE
        tmTimers[tiIndex].ET := 0.0; // Not running, clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Not running, clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Not running, output off
    END_IF;
END_FOR;

END_FUNCTION_BLOCK
