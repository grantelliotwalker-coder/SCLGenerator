FUNCTION_BLOCK "DutyPump2"
TITLE = 'Two pump duty/standby level controller'
{
S7_m_c:='true';
S7_tasklist:='OB100'
}
AUTHOR : 'AUTHOR'
FAMILY : 'FAMILY'
NAME : 'DUTY2'
VERSION : '1.0'
KNOW_HOW_PROTECT

// Purpose : Runs one of two pumps on rising level, alternates duty each cycle, brings in the second pump on high level.
//
// How it works:
// Lead request starts when Level stays at or above StartLevel for StartDelay seconds and stops at or below StopLevel.
// Assist request starts when Level stays at or above AssistLevel for AssistDelay seconds while lead is running.
// Duty swaps between pumps each time the lead request ends. An unavailable duty pump is replaced by the standby pump.
// ASSUMPTION: levels in % (0-100); start 60, stop 20, assist 80; delays 5 s and 10 s.
//
// Generated by sclgen 1.0 from a JSON block spec. Edit the spec and regenerate
// rather than editing this file by hand.

VAR_INPUT
    Enable {S7_m_c:='true'} : BOOL := TRUE; // Block enable, auto mode
    Level {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 0.0; // Wet well level (%)
    StartLevel {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 60.0; // Lead pump start level (%)
    StopLevel {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 20.0; // All pumps stop level (%)
    AssistLevel {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 80.0; // Assist pump start level (%)
    StartDelay {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 5.0; // Seconds above StartLevel before lead starts
    AssistDelay {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 10.0; // Seconds above AssistLevel before assist starts
    Pump1Avail {S7_m_c:='true'} : BOOL := FALSE; // Pump 1 available (auto, healthy, no fault)
    Pump2Avail {S7_m_c:='true'} : BOOL := FALSE; // Pump 2 available (auto, healthy, no fault)
    SampleTime {S7_visible:='false'; S7_sampletime:='true'; S7_param:='false'; S7_link:='false'} : REAL; // Cycle time of the PLC in seconds, used for timer logic
END_VAR

VAR_OUTPUT
    Pump1Run {S7_m_c:='true'} : BOOL := FALSE; // Run command to pump 1
    Pump2Run {S7_m_c:='true'} : BOOL := FALSE; // Run command to pump 2
    DutyPump {S7_m_c:='true'} : INT := 1; // Current duty pump number, 1 or 2
    NoPumpAvail {S7_m_c:='true'} : BOOL := FALSE; // Alarm, pumping required but no pump available
    State {S7_m_c:='true'} : INT := 0; // State, 0 = idle, 1 = start delay, 2 = lead running, 3 = lead and assist, 9 = no pump
    StatusString {S7_m_c:='true'} : STRING[50]; // Diagnostic status for the operator screen
END_VAR

VAR
    // Internal working variables
    LeadReq : BOOL := FALSE; // One pump required
    AssistReq : BOOL := FALSE; // Second pump required
    LeadReqPrev : BOOL := FALSE; // LeadReq last scan, for duty alternation
    DutyIsP2 : BOOL := FALSE; // TRUE when pump 2 is duty, kept through disable
    LeadIsP1 : BOOL := FALSE; // Lead request goes to pump 1
    LeadIsP2 : BOOL := FALSE; // Lead request goes to pump 2

    tmTimers : ARRAY[0..1] OF STRUCT // Timer array, index 0 = start_delay, index 1 = assist_delay
        IN : BOOL; // Timer input, TRUE starts the timer accumulating
        Q : BOOL; // Timer output, TRUE when ET reaches PT, stays TRUE while IN is held
        RESET : BOOL := FALSE; // Set TRUE to clear ET/RT and hold Q FALSE for one scan, engine clears it
        PT : REAL; // Preset time in seconds, written every scan in the timer presets section
        ET : REAL; // Elapsed time in seconds, incremented each scan by SampleTime
        RT : REAL; // Remaining time in seconds, PT minus ET, clamped to zero
    END_STRUCT;
    tiIndex : INT; // Loop index for the timer execution FOR loop
END_VAR

BEGIN

// -----------------------------------------------------------------------------------------
// SECTION 1: BLOCK ENABLE AND RESET
// If Enable is FALSE, everything is reset to a clean idle state and the block exits.
// This ensures the block always starts fresh when re-enabled after being disabled.
// -----------------------------------------------------------------------------------------
IF NOT Enable THEN
    Pump1Run := FALSE; // Back to initial value
    Pump2Run := FALSE; // Back to initial value
    DutyPump := 1; // Back to initial value
    NoPumpAvail := FALSE; // Back to initial value
    LeadReq := FALSE; // Back to initial value
    AssistReq := FALSE; // Back to initial value
    LeadReqPrev := FALSE; // Back to initial value
    LeadIsP1 := FALSE; // Back to initial value
    LeadIsP2 := FALSE; // Back to initial value
    State := 0; // Return to safe state
    StatusString := 'Disabled';
    FOR tiIndex := 0 TO 1 DO // Stop and clear every timer
        tmTimers[tiIndex].IN := FALSE;
        tmTimers[tiIndex].Q := FALSE;
        tmTimers[tiIndex].RESET := FALSE;
        tmTimers[tiIndex].ET := 0.0;
        tmTimers[tiIndex].RT := 0.0;
    END_FOR;
    RETURN; // Exit the block early, skip all logic below
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 2: TIMER PRESETS
// Presets are written every scan so changes from the HMI or engineering take effect immediately.
// Presets taken from inputs are clamped to 0..86400 s so a bad entry cannot break the timer.
// -----------------------------------------------------------------------------------------
tmTimers[0].PT := LIMIT(MN:=0.0, IN:=StartDelay, MX:=86400.0); // start_delay: Level confirmed above start level
tmTimers[1].PT := LIMIT(MN:=0.0, IN:=AssistDelay, MX:=86400.0); // assist_delay: Level confirmed above assist level

// -----------------------------------------------------------------------------------------
// SECTION 3: LEVEL CONTROL
// Lead and assist requests with start/stop hysteresis and confirmation delays.
// -----------------------------------------------------------------------------------------
tmTimers[0].IN := Level >= StartLevel AND NOT LeadReq; // Confirm level before starting
IF tmTimers[0].Q THEN
    LeadReq := TRUE;
    tmTimers[0].RESET := TRUE;
END_IF;

tmTimers[1].IN := LeadReq AND NOT AssistReq AND Level >= AssistLevel; // Confirm high level
IF tmTimers[1].Q THEN
    AssistReq := TRUE;
    tmTimers[1].RESET := TRUE;
END_IF;

IF Level <= StopLevel THEN
    LeadReq := FALSE; // Pumped down, stop everything
    AssistReq := FALSE;
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 4: DUTY ALTERNATION
// Duty swaps to the other pump each time a pump-down cycle ends to even out run hours.
// -----------------------------------------------------------------------------------------
IF LeadReqPrev AND NOT LeadReq THEN
    DutyIsP2 := NOT DutyIsP2; // Cycle finished, swap duty
END_IF;
LeadReqPrev := LeadReq;

// -----------------------------------------------------------------------------------------
// SECTION 5: PUMP SELECTION
// Lead goes to the duty pump, or to the standby pump if duty is unavailable. Assist uses the other pump.
// -----------------------------------------------------------------------------------------
LeadIsP1 := (NOT DutyIsP2 AND Pump1Avail) OR (DutyIsP2 AND NOT Pump2Avail AND Pump1Avail);
LeadIsP2 := (DutyIsP2 AND Pump2Avail) OR (NOT DutyIsP2 AND NOT Pump1Avail AND Pump2Avail);

Pump1Run := Pump1Avail AND ((LeadReq AND LeadIsP1) OR (AssistReq AND LeadIsP2));
Pump2Run := Pump2Avail AND ((LeadReq AND LeadIsP2) OR (AssistReq AND LeadIsP1));

IF DutyIsP2 THEN
    DutyPump := 2;
ELSE
    DutyPump := 1;
END_IF;
NoPumpAvail := LeadReq AND NOT Pump1Avail AND NOT Pump2Avail; // Pumping needed, nothing to run

// -----------------------------------------------------------------------------------------
// SECTION 6: STATE AND STATUS
// State gives a simple integer state that can be trended or alarmed on the HMI.
// StatusString gives a plain English description for diagnostics on the operator screen.
// States are tested in priority order; the first matching condition wins.
// -----------------------------------------------------------------------------------------
IF NoPumpAvail THEN
    State := 9; // No pump available
ELSIF Pump1Run AND Pump2Run THEN
    State := 3; // Lead and assist
ELSIF Pump1Run OR Pump2Run THEN
    State := 2; // Lead running
ELSIF tmTimers[0].IN THEN
    State := 1; // Start delay
ELSE
    State := 0; // Idle
END_IF;

CASE State OF
    0: // Idle
        StatusString := 'Idle: Level normal';
    1: // Start delay
        StatusString := 'Level high: Start delay timing';
    2: // Lead running
        StatusString := 'Running: Duty pump';
    3: // Lead and assist
        StatusString := 'Running: Both pumps';
    9: // No pump available
        StatusString := 'Alarm: No pump available';
    ELSE // Unexpected state, fail safe
        StatusString := 'Error/Unknown';
        State := 0; // Force back to safe state so block recovers automatically
END_CASE;

//********************************************************************************************
// Timers execution
// Runs every timer in the array with a single FOR loop; each element works identically.
// SampleTime is added to ET each scan the timer IN is active. When ET reaches PT, RT reaches
// zero and Q goes TRUE. Q stays TRUE while IN is held. RESET clears the timer for one scan
// and is then cleared by the engine itself, so the timer is ready for its next cycle.
//********************************************************************************************
FOR tiIndex := 0 TO 1 DO
    IF tmTimers[tiIndex].RESET THEN
        tmTimers[tiIndex].ET := 0.0; // Clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Hold output off while resetting
        tmTimers[tiIndex].RESET := FALSE; // Reset handled, clear the flag so the timer can run again
    ELSIF tmTimers[tiIndex].IN THEN
        IF NOT tmTimers[tiIndex].Q THEN
            tmTimers[tiIndex].ET := tmTimers[tiIndex].ET + SampleTime; // Accumulate elapsed time
        END_IF;
        tmTimers[tiIndex].RT := LIMIT(MN:=0.0, IN:=tmTimers[tiIndex].PT - tmTimers[tiIndex].ET, MX:=tmTimers[tiIndex].PT); // Remaining time, never below 0
        tmTimers[tiIndex].Q := tmTimers[tiIndex].RT <= 0.0; // Done when no time remains
    ELSE
        tmTimers[tiIndex].ET := 0.0; // Not running, clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Not running, clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Not running, output off
    END_IF;
END_FOR;

END_FUNCTION_BLOCK
