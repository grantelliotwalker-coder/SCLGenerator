FUNCTION_BLOCK "PumpRunMon"
TITLE = 'Pump run feedback monitor'
{
S7_m_c:='true';
S7_tasklist:='OB100'
}
AUTHOR : 'WALKER'
FAMILY : 'GCCC'
NAME : 'PMPRUN'
VERSION : '1.0'
KNOW_HOW_PROTECT

// Purpose : Checks a pump's run feedback against its run command and latches fail to start / fail to stop faults.
//
// How it works:
// Fail to start: RunCmd is TRUE but RunFbk is not seen within StartCheckTime seconds.
// Fail to stop: RunCmd is FALSE but RunFbk is still TRUE after StopCheckTime seconds.
// Faults latch until a rising edge on FaultReset. Fault is the OR of both faults.
//
// Generated by sclgen 1.0 from a JSON block spec. Edit the spec and regenerate
// rather than editing this file by hand.

VAR_INPUT
    Enable {S7_m_c:='true'} : BOOL := TRUE; // Block enable, must be TRUE for any monitoring to run
    RunCmd {S7_m_c:='true'} : BOOL := FALSE; // Run command sent to the pump starter
    RunFbk {S7_m_c:='true'} : BOOL := FALSE; // Run feedback from the starter auxiliary contact
    FaultReset {S7_m_c:='true'} : BOOL := FALSE; // Fault reset, rising edge clears latched faults
    StartCheckTime {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 10.0; // Seconds allowed for run feedback after the run command
    StopCheckTime {S7_m_c:='true'; S7_param:='true'; S7_read_back:='always'; S7_link:='false'} : REAL := 10.0; // Seconds allowed for run feedback to drop after the command is removed
    SampleTime {S7_visible:='false'; S7_sampletime:='true'; S7_param:='false'; S7_link:='false'} : REAL; // Cycle time of the PLC in seconds, used for timer logic
END_VAR

VAR_OUTPUT
    FailToStart {S7_m_c:='true'} : BOOL := FALSE; // Latched fault, no run feedback within StartCheckTime
    FailToStop {S7_m_c:='true'} : BOOL := FALSE; // Latched fault, run feedback still present after StopCheckTime
    Fault {S7_m_c:='true'} : BOOL := FALSE; // Common fault, TRUE if either fault is latched
    State {S7_m_c:='true'} : INT := 0; // State, 0 = stopped, 1 = starting, 2 = running, 3 = stopping, 9 = fault
    StatusString {S7_m_c:='true'} : STRING[50]; // Diagnostic status string for the operator screen
END_VAR

VAR
    // Internal working variables
    FaultResetPrev : BOOL := FALSE; // FaultReset value from the previous scan for rising edge detection

    tmTimers : ARRAY[0..1] OF STRUCT // Timer array, index 0 = start_check, index 1 = stop_check
        IN : BOOL; // Timer input, TRUE starts the timer accumulating
        Q : BOOL; // Timer output, TRUE when ET reaches PT, stays TRUE while IN is held
        RESET : BOOL := FALSE; // Set TRUE to clear ET/RT and hold Q FALSE for one scan, engine clears it
        PT : REAL; // Preset time in seconds, written every scan in the timer presets section
        ET : REAL; // Elapsed time in seconds, incremented each scan by SampleTime
        RT : REAL; // Remaining time in seconds, PT minus ET, clamped to zero
    END_STRUCT;
    tiIndex : INT; // Loop index for the timer execution FOR loop
END_VAR

BEGIN

// -----------------------------------------------------------------------------------------
// SECTION 1: BLOCK ENABLE AND RESET
// If Enable is FALSE, everything is reset to a clean idle state and the block exits.
// This ensures the block always starts fresh when re-enabled after being disabled.
// -----------------------------------------------------------------------------------------
IF NOT Enable THEN
    FailToStart := FALSE; // Back to initial value
    FailToStop := FALSE; // Back to initial value
    Fault := FALSE; // Back to initial value
    FaultResetPrev := FALSE; // Back to initial value
    State := 0; // Return to safe state
    StatusString := 'Disabled';
    FOR tiIndex := 0 TO 1 DO // Stop and clear every timer
        tmTimers[tiIndex].IN := FALSE;
        tmTimers[tiIndex].Q := FALSE;
        tmTimers[tiIndex].RESET := FALSE;
        tmTimers[tiIndex].ET := 0.0;
        tmTimers[tiIndex].RT := 0.0;
    END_FOR;
    RETURN; // Exit the block early, skip all logic below
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 2: TIMER PRESETS
// Presets are written every scan so changes from the HMI or engineering take effect immediately.
// Presets taken from inputs are clamped to 0..86400 s so a bad entry cannot break the timer.
// -----------------------------------------------------------------------------------------
tmTimers[0].PT := LIMIT(MN:=0.0, IN:=StartCheckTime, MX:=86400.0); // start_check: Fail to start check
tmTimers[1].PT := LIMIT(MN:=0.0, IN:=StopCheckTime, MX:=86400.0); // stop_check: Fail to stop check

// -----------------------------------------------------------------------------------------
// SECTION 3: FAULT DETECTION
// Each check timer runs while command and feedback disagree.
// A timer elapsing latches the matching fault.
// -----------------------------------------------------------------------------------------
tmTimers[0].IN := RunCmd AND NOT RunFbk AND NOT FailToStart; // Commanded on, no feedback yet
tmTimers[1].IN := NOT RunCmd AND RunFbk AND NOT FailToStop; // Commanded off, feedback still on

IF tmTimers[0].Q THEN
    FailToStart := TRUE; // Latch fail to start
END_IF;

IF tmTimers[1].Q THEN
    FailToStop := TRUE; // Latch fail to stop
END_IF;

// -----------------------------------------------------------------------------------------
// SECTION 4: FAULT RESET
// A rising edge on FaultReset clears both latched faults and restarts the checks.
// -----------------------------------------------------------------------------------------
IF FaultReset AND NOT FaultResetPrev THEN
    FailToStart := FALSE;
    FailToStop := FALSE;
    tmTimers[0].RESET := TRUE; // Restart the check if the condition is still present
    tmTimers[1].RESET := TRUE;
END_IF;
FaultResetPrev := FaultReset; // Remember for edge detection next scan

Fault := FailToStart OR FailToStop; // Common fault

// -----------------------------------------------------------------------------------------
// SECTION 5: STATE AND STATUS
// State gives a simple integer state that can be trended or alarmed on the HMI.
// StatusString gives a plain English description for diagnostics on the operator screen.
// States are tested in priority order; the first matching condition wins.
// -----------------------------------------------------------------------------------------
IF Fault THEN
    State := 9; // Fault
ELSIF tmTimers[0].IN THEN
    State := 1; // Starting
ELSIF RunCmd AND RunFbk THEN
    State := 2; // Running
ELSIF tmTimers[1].IN THEN
    State := 3; // Stopping
ELSE
    State := 0; // Stopped
END_IF;

CASE State OF
    0: // Stopped
        StatusString := 'Stopped';
    1: // Starting
        StatusString := 'Starting: Waiting for run feedback';
    2: // Running
        StatusString := 'Running';
    3: // Stopping
        StatusString := 'Stopping: Waiting for feedback to drop';
    9: // Fault
        StatusString := 'Fault: Check pump and reset';
    ELSE // Unexpected state, fail safe
        StatusString := 'Error/Unknown';
        State := 0; // Force back to safe state so block recovers automatically
END_CASE;

//********************************************************************************************
// Timers execution
// Runs every timer in the array with a single FOR loop; each element works identically.
// SampleTime is added to ET each scan the timer IN is active. When ET reaches PT, RT reaches
// zero and Q goes TRUE. Q stays TRUE while IN is held. RESET clears the timer for one scan
// and is then cleared by the engine itself, so the timer is ready for its next cycle.
//********************************************************************************************
FOR tiIndex := 0 TO 1 DO
    IF tmTimers[tiIndex].RESET THEN
        tmTimers[tiIndex].ET := 0.0; // Clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Hold output off while resetting
        tmTimers[tiIndex].RESET := FALSE; // Reset handled, clear the flag so the timer can run again
    ELSIF tmTimers[tiIndex].IN THEN
        IF NOT tmTimers[tiIndex].Q THEN
            tmTimers[tiIndex].ET := tmTimers[tiIndex].ET + SampleTime; // Accumulate elapsed time
        END_IF;
        tmTimers[tiIndex].RT := LIMIT(MN:=0.0, IN:=tmTimers[tiIndex].PT - tmTimers[tiIndex].ET, MX:=tmTimers[tiIndex].PT); // Remaining time, never below 0
        tmTimers[tiIndex].Q := tmTimers[tiIndex].RT <= 0.0; // Done when no time remains
    ELSE
        tmTimers[tiIndex].ET := 0.0; // Not running, clear elapsed time
        tmTimers[tiIndex].RT := 0.0; // Not running, clear remaining time
        tmTimers[tiIndex].Q := FALSE; // Not running, output off
    END_IF;
END_FOR;

END_FUNCTION_BLOCK
