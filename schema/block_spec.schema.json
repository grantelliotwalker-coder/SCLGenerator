{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scl-block-spec-1.0",
  "title": "SCL function block spec v1.0",
  "description": "Input format for sclgen.html. One spec = one FUNCTION_BLOCK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "block",
    "enable_input",
    "inputs",
    "outputs",
    "logic_sections",
    "state_machine"
  ],
  "properties": {
    "spec_version": {
      "const": "1.0"
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "author",
        "family",
        "short_name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 24
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "maxLength": 8
        },
        "family": {
          "type": "string",
          "maxLength": 8
        },
        "short_name": {
          "type": "string",
          "maxLength": 8
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}$"
        },
        "type": {
          "const": "FUNCTION_BLOCK"
        },
        "know_how_protect": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        },
        "how_it_works": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "enable_input": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 24
    },
    "sample_time_input": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 24
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 24
          },
          "type": {
            "type": "string",
            "pattern": "^(BOOL|BYTE|WORD|DWORD|INT|DINT|REAL|TIME|S5TIME|DATE|TIME_OF_DAY|TOD|CHAR|STRING\\[[0-9]{1,3}\\])$"
          },
          "initial": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_value": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_on_disable": {
            "type": "boolean"
          },
          "attr_preset": {
            "type": "string",
            "enum": [
              "none",
              "hmi",
              "param",
              "sampletime"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 24
          },
          "type": {
            "type": "string",
            "pattern": "^(BOOL|BYTE|WORD|DWORD|INT|DINT|REAL|TIME|S5TIME|DATE|TIME_OF_DAY|TOD|CHAR|STRING\\[[0-9]{1,3}\\])$"
          },
          "initial": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_value": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_on_disable": {
            "type": "boolean"
          },
          "attr_preset": {
            "type": "string",
            "enum": [
              "none",
              "hmi",
              "param",
              "sampletime"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "in_outs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 24
          },
          "type": {
            "type": "string",
            "pattern": "^(BOOL|BYTE|WORD|DWORD|INT|DINT|REAL|TIME|S5TIME|DATE|TIME_OF_DAY|TOD|CHAR|STRING\\[[0-9]{1,3}\\])$"
          },
          "initial": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_value": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_on_disable": {
            "type": "boolean"
          },
          "attr_preset": {
            "type": "string",
            "enum": [
              "none",
              "hmi",
              "param",
              "sampletime"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "statics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 24
          },
          "type": {
            "type": "string",
            "pattern": "^(BOOL|BYTE|WORD|DWORD|INT|DINT|REAL|TIME|S5TIME|DATE|TIME_OF_DAY|TOD|CHAR|STRING\\[[0-9]{1,3}\\])$"
          },
          "initial": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_value": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          },
          "reset_on_disable": {
            "type": "boolean"
          },
          "attr_preset": {
            "type": "string",
            "enum": [
              "none",
              "hmi",
              "param",
              "sampletime"
            ]
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "preset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 24
          },
          "comment": {
            "type": "string"
          },
          "preset": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seconds"
                ],
                "properties": {
                  "seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "maxLength": 24
                  }
                }
              }
            ]
          }
        }
      }
    },
    "logic_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "scl"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scl": {
            "type": "string",
            "description": "SCL statements. Use {timer:<id>} to reference a timer, e.g. {timer:on_delay}.Q"
          }
        }
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_output",
        "status_output",
        "states"
      ],
      "properties": {
        "state_output": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 24
        },
        "status_output": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 24
        },
        "safe_value": {
          "type": "integer",
          "minimum": 0
        },
        "disabled_status": {
          "type": "string"
        },
        "unknown_status": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "name",
              "condition",
              "status"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32767
              },
              "name": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "description": "Boolean SCL expression, or ELSE on the last state"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}